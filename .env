# Database configuration (SQLite)
DATABASE_URL=./data/database.db

# Development environment
NODE_ENV=development

# Server port
PORT=5000

# Session secret
SESSION_SECRET=development-secret-key-change-in-production

# CopilotKit configuration
VITE_COPILOT_RUNTIME_URL=http://localhost:5000/api/copilotkit
VITE_COPILOT_WS_URL=ws://localhost:5000

# AI Providers Configuration
# GitHub Copilot API (using copilot-api proxy)
COPILOT_API_ENABLED=true
COPILOT_API_URL=http://localhost:8080
GITHUB_TOKEN=
COPILOT_TIMEOUT=30000
COPILOT_MAX_RETRIES=3
COPILOT_RATE_LIMIT=60

# OpenAI API (fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API (fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Client configuration
VITE_API_BASE_URL=http://localhost:5000
