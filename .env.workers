# Production Environment Variables for Cloudflare Workers Backend (api-beta.bitebase.app)

# Set these as Wrangler secrets:
# wrangler secret put OPENAI_API_KEY
# wrangler secret put GITHUB_TOKEN
# wrangler secret put SESSION_SECRET

# Copy the values from .env:
OPENAI_API_KEY=your_openai_api_key_here
GITHUB_TOKEN=your_github_token_here
SESSION_SECRET=bitebase-production-secret-key-$(date +%s)

# Wrangler commands to set secrets:
# wrangler secret put OPENAI_API_KEY --text "your_openai_api_key_here"
# wrangler secret put GITHUB_TOKEN --text "your_github_token_here"
# wrangler secret put SESSION_SECRET --text "bitebase-production-secret-$(date +%s)"